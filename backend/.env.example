# Archivo de ejemplo para las variables de entorno del Backend
# Copia este archivo como ".env" en esta misma carpeta y ajusta los valores para tu entorno local.
# Si estás usando docker-compose, estas variables se sobreescriben automáticamente en ese archivo.

# Configuración de Base de Datos
DB_URL=ULTRA_SECRET_DB_URL_HERE
DB_USER=ULTRA_SECRET_DB_USER_HERE
DB_PASSWORD=ULTRA_SECRET_DB_PASSWORD_HERE

# Configuración de CORS (Orígenes permitidos, separados por comas)
# En desarrollo local suele ser localhost:5173. En producción, la URL de tu frontend (ej. https://mi-app.vercel.app)
CORS_ALLOWED_ORIGINS=ULTRA_SECRET_CORS_ORIGINS_HERE

# Configuración JWT
# Clave simétrica en Base64URL (mínimo 256 bits = 32 bytes).
# Generar con: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# En Windows con: openssl rand -base64 32 | wsl tr '+/' '-_' | wsl tr -d '='
# Nota: se aceptan los caracteres '-', '_' como sustitutos de '+', '/' de base64 y no acepta '='.
JWT_SECRET=ULTRA_SECRET_JWT_KEY_HERE

# Tiempo de vida del token en milisegundos.
# Desarrollo: 86400000 (24 horas) | Producción: 3600000 (1 hora)
JWT_EXPIRATION_MS=86400000

# Tiempo de vida del Refresh Token en milisegundos (expiración absoluta desde el login).
# El usuario DEBE volver a loguearse cuando este tiempo se cumpla, sin importar cuánto use la app.
# Desarrollo: 604800000 = 7 días | Producción: 604800000 = 7 días
JWT_REFRESH_EXPIRATION_MS=604800000
# Flag Secure para cookies HttpOnly (false en desarrollo local HTTP, true en producción HTTPS)
JWT_COOKIE_SECURE=false

# Activa/desactiva la interfaz de Swagger UI.
# Mantener en 'true' para local/desarrollo y cambiar a 'false' en producción.
SWAGGER_ENABLED=true
