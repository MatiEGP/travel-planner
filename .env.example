# Archivo de ejemplo para las variables de entorno de docker-compose
# Crea un archivo ".env" en esta raíz basado en este archivo.
# Docker Compose leerá automáticamente este archivo al hacer "docker compose up".

# ---- BASE DE DATOS ----
POSTGRES_DB=ULTRA_SECRET_DB_NAME_HERE
POSTGRES_USER=ULTRA_SECRET_DB_USER_HERE
POSTGRES_PASSWORD=ULTRA_SECRET_DB_PASSWORD_HERE

# ---- BACKEND ----
# En desarrollo local suele ser http://localhost:5173. 
# En producción, pon la URL final de tu frontend (ej. https://mi-app.vercel.app)
CORS_ALLOWED_ORIGINS=ULTRA_SECRET_CORS_ORIGINS_HERE

# ---- FRONTEND ----
# URL de tu backend para que el frontend pueda hacer las llamadas API.
VITE_BACKEND_API_URL=ULTRA_SECRET_BACKEND_URL_HERE
