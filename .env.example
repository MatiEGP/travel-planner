# Archivo de ejemplo para las variables de entorno de Docker Compose
# Crea un archivo ".env" en esta raíz basado en este archivo.
# Docker Compose leerá automáticamente este archivo al ejecutar:
#   docker compose -f docker-compose.dev.yml up
#   docker compose -f docker-compose.prod.yml up --build

# ---- BASE DE DATOS ----
POSTGRES_DB=ULTRA_SECRET_DB_NAME_HERE
POSTGRES_USER=ULTRA_SECRET_DB_USER_HERE
POSTGRES_PASSWORD=ULTRA_SECRET_DB_PASSWORD_HERE

# ---- BACKEND ----
# En desarrollo local suele ser http://localhost:5173. 
# En producción, pon la URL final de tu frontend (ej. https://mi-app.vercel.app)
CORS_ALLOWED_ORIGINS=ULTRA_SECRET_CORS_ORIGINS_HERE

# Clave simétrica en Base64URL (mínimo 256 bits = 32 bytes).
# Generar con: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# En Windows con: openssl rand -base64 32 | wsl tr '+/' '-_' | wsl tr -d '='
# Nota: se aceptan los caracteres '-', '_' como sustitutos de '+', '/' de base64 y no acepta '='.
JWT_SECRET=ULTRA_SECRET_JWT_KEY_HERE
# Tiempo de vida del token en milisegundos (Desarrollo: 86400000 = 24h | Producción: 3600000 = 1h)
JWT_EXPIRATION_MS=86400000
# Flag Secure para cookies HttpOnly (false en desarrollo local HTTP, true en producción HTTPS)
JWT_COOKIE_SECURE=false

# Swagger UI / OpenAPI docs (true en desarrollo, false en producción)
SWAGGER_ENABLED=true

# ---- FRONTEND ----
# URL de tu backend para que el frontend pueda hacer las llamadas API.
VITE_BACKEND_API_URL=ULTRA_SECRET_BACKEND_URL_HERE
